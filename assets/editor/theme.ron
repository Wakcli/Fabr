(
    base: "dark",
    colors: {
        // Shell palette shared by the hub and the editor frame.
        "surface.window": "#0D0D0D",
        "surface.pane_header": "#151515",
        "surface.pane_body": "#111111",
        "text.default": "#E8E8E8",
        "text.dim": "#8A8A8A",
        "border.default": "#2B2B2B",
        "fill.accent": "#E8743B",
        "fill.solid": "#262626",
        "fill.item_hover": "#1E1E1E",
        "fill.field": "#1A1A1A",
        "axis.x": "#FF5C61",
        "axis.y": "#67D08A",
        "axis.z": "#5B9DFF",
        "focus.ring": "#E8743BAA",

        // Editor chrome: neutral surfaces and text, with hue only where it carries
        // meaning (class badges, transform axes, folders, the brand accent).
        "editor.window": "#0B0B0B",
        "editor.panel": "#171717",
        "editor.inset": "#101010",
        "editor.border": "#2B2B2B",
        "editor.separator": "#FFFFFF14",
        "editor.text": "#E8E8E8",
        "editor.select.text": "#FFFFFF",
        "editor.text.dim": "#7A7A7A",
        "editor.text.medium": "#A6A6A6",
        "editor.accent": "#E8743B",
        "editor.accent.text": "#1A0F08",
        "editor.tab.highlight": "#E8743B",
        "editor.drop": "#E8743B55",
        "editor.select": "#4A2A1A",
        "editor.scrim": "#00000099",
        "editor.clear": "#00000000",
        "editor.field": "#111111",
        "editor.field.line": "#333333",
        "editor.label.strip": "#222222",
        "editor.category": "#202020",
        "editor.section.text": "#D2D2D2",
        "editor.prop.text": "#9C9C9C",
        "editor.axis.x": "#FF5C61",
        "editor.axis.y": "#67D08A",
        "editor.axis.z": "#5B9DFF",
        "editor.axis.x.text": "#FFA0A3",
        "editor.axis.y.text": "#A6E8BC",
        "editor.axis.z.text": "#A8C8FF",
        "editor.viewport.top": "#242424",
        "editor.viewport.bottom": "#0A0A0A",
        "editor.grid": "#FFFFFF12",
        "editor.grid.strong": "#FFFFFF22",
        "editor.icon": "#C9C9C9",
        "editor.icon.folder": "#E8B45A",
        "editor.class.node": "#FF6B6B",
        "editor.class.scene": "#B08CFF",
        "editor.class.light": "#F2CE5C",
        "editor.class.camera": "#6FA8FF",
        "editor.class.mesh": "#F5A03C",
    },
)
