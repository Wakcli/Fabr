(
    player: (
        title: "Fabr Game",
        width: 1280,
        height: 720,
        vsync: true,
    ),
    graphics: (
        msaa: 4,
    ),
    audio: (
        master_volume: 1.0,
    ),
    quality: (
        shadows: true,
    ),
    input: (
        actions: {
            "jump": [
                "Space",
            ],
            "move_back": [
                "S",
                "ArrowDown",
            ],
            "move_forward": [
                "W",
                "ArrowUp",
            ],
            "move_left": [
                "A",
                "ArrowLeft",
            ],
            "move_right": [
                "D",
                "ArrowRight",
            ],
        },
    ),
)